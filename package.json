{
  "name": "sitewatch-simple",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "node scripts/create-db.mjs && prisma generate && prisma db push && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx tests/api.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5",
    "@prisma/adapter-better-sqlite3": "7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
